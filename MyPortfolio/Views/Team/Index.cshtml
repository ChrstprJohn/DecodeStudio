@model List<MyPortfolio.Models.Entities.TeamMember>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Team members";
}
<h1 class="page-title">Team members</h1>
<a asp-action="Create" class="action-primary my-7">Add team member</a>
@if (Model.Count == 0)
{
    <p>No entries yet.</p>
}
else
{
    <div class="overflow-x-auto rounded-lg bg-white">
    <table class="data-table">
        <thead><tr><th scope="col">Name</th><th scope="col">Status</th><th scope="col">Order</th><th scope="col">Actions</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr class="border-t border-slate-200">
                <td class="py-3">@( item.FirstName + " " + item.LastName )</td><td>@(item.IsPublished ? "Published" : "Draft")</td><td>@item.SortOrder</td>
                <td><a asp-action="Edit" asp-route-id="@item.Id" class="underline">Edit</a> · <a asp-action="Delete" asp-route-id="@item.Id" class="underline">Delete</a></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
