@model List<MyPortfolio.Models.Entities.TeamMember>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Team";
}
<div class="admin-page-header">
    <h1 class="page-title">Team</h1>
    <a asp-action="Create" class="admin-primary">Add team member</a>
</div>
@if (Model.Count == 0)
{
    <p>No entries yet.</p>
}
else
{
    <div class="admin-table-panel">
    <table class="data-table">
        <thead><tr><th scope="col">Image</th><th scope="col">Name</th><th scope="col">Status</th><th scope="col">Order</th><th scope="col" class="admin-actions-heading">Actions</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr class="border-t border-slate-200">
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.PhotoPath))
                    {
                        <img src="@item.PhotoPath" alt="" loading="lazy" class="admin-thumbnail" />
                    }
                    else
                    {
                        <span class="admin-empty-image">No image</span>
                    }
                </td>
                <td class="py-3">@( item.FirstName + " " + item.LastName )</td><td><span class="admin-status @(item.IsPublished ? "admin-status-positive" : "")">@(item.IsPublished ? "Published" : "Draft")</span></td><td>@item.SortOrder</td>
                <td><div class="admin-row-actions"><a asp-action="Edit" asp-route-id="@item.Id" >Edit</a> <a asp-action="Delete" asp-route-id="@item.Id" class="admin-delete-action" data-confirm-delete="Delete team member" data-delete-message="@($"Delete {item.FirstName + " " + item.LastName}? This cannot be undone.")">Delete</a></div></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
