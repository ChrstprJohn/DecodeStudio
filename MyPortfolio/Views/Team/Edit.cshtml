@model TeamMemberViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit team member";
}
<partial name="_EditBackLink" model='("Back to team")' />
<h1 class="page-title">@ViewData["Title"]</h1>
<form asp-controller="Team" asp-action="Edit" method="post" enctype="multipart/form-data" class="edit-form mt-6 max-w-3xl rounded-xl border border-neutral-200 bg-white p-5 sm:p-7">
    <input asp-for="Id" type="hidden" />
    <partial name="_FormFields" model="Model" />
</form>
