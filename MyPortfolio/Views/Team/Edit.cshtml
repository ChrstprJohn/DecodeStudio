@model TeamMemberViewModel
@{
    Layout = "_AdminLayout";
    var action = Model.Id == 0 ? "Create" : "Edit";
    ViewData["Title"] = action + " team member";
}
<partial name="_EditBackLink" model='("Back to team")' />
<h1 class="page-title">@ViewData["Title"]</h1>
<form asp-action="@action" method="post" enctype="multipart/form-data" class="edit-form mt-6 max-w-3xl rounded-xl border border-neutral-200 bg-white p-5 sm:p-7">
    <div asp-validation-summary="ModelOnly" role="alert" class="text-red-700"></div>
    <input asp-for="Id" type="hidden" />
    <div>
        <label asp-for="FirstName" class="block"></label>
        <input asp-for="FirstName" placeholder="e.g. Alex" class="mt-2 w-full" />
        <span asp-validation-for="FirstName" class="field-error"></span>
    </div>
    <div>
        <label asp-for="MiddleName" class="block"></label>
        <input asp-for="MiddleName" placeholder="Optional" class="mt-2 w-full" />
        <span asp-validation-for="MiddleName" class="field-error"></span>
    </div>
    <div>
        <label asp-for="LastName" class="block"></label>
        <input asp-for="LastName" placeholder="e.g. Rivera" class="mt-2 w-full" />
        <span asp-validation-for="LastName" class="field-error"></span>
    </div>
    <div>
        <label asp-for="RoleTitle" class="block"></label>
        <input asp-for="RoleTitle" placeholder="e.g. Web developer" class="mt-2 w-full" />
        <span asp-validation-for="RoleTitle" class="field-error"></span>
    </div>
    <div>
        <label asp-for="Bio" class="block"></label>
        <textarea asp-for="Bio" placeholder="Introduce this person and describe what they do." rows="4" class="mt-2 w-full"></textarea>
        <span asp-validation-for="Bio" class="field-error"></span>
    </div>
    <div>
        <label asp-for="ImageFile" class="block"></label>
        <input asp-for="ImageFile" type="file" accept="image/png,image/jpeg,image/webp" class="sr-only" data-upload-preview />
        <partial name="_UploadPreview" model='("ImageFile", Model.PhotoPath)' />
        <span asp-validation-for="ImageFile" class="field-error"></span>
        @if (!string.IsNullOrEmpty(Model.PhotoPath))
        {
            <label class="mt-3 block"><input asp-for="RemoveImage" /> Remove current image</label>
        }
    </div>

    <div>
        <label asp-for="SortOrder" class="block"></label>
        <input asp-for="SortOrder" class="mt-2 w-full" />
        <span asp-validation-for="SortOrder" class="field-error"></span>
    </div>
    <div>
        <label><input asp-for="IsPublished" /> Published</label>
        <span asp-validation-for="IsPublished" class="field-error"></span>
    </div>
    <div class="edit-form-actions">
        <button type="submit" class="admin-primary">Save</button>
        <a asp-action="Index" class="admin-secondary">Cancel</a>
    </div>
</form>
