@model TeamMemberViewModel
@{
    Layout = "_AdminLayout";
    var action = Model.Id == 0 ? "Create" : "Edit";
    ViewData["Title"] = action + " team member";
}
<h1 class="page-title">@ViewData["Title"]</h1>
<form asp-action="@action" method="post" enctype="multipart/form-data" class="mt-8 max-w-3xl space-y-6 rounded-xl bg-white p-6 md:p-8">
    <div asp-validation-summary="ModelOnly" role="alert" class="text-red-700"></div>
    <input asp-for="Id" type="hidden" />
    <div>
        <label asp-for="FirstName" class="block"></label>
        <input asp-for="FirstName" class="mt-2 w-full" />
        <span asp-validation-for="FirstName" class="field-error"></span>
    </div>
    <div>
        <label asp-for="MiddleName" class="block"></label>
        <input asp-for="MiddleName" class="mt-2 w-full" />
        <span asp-validation-for="MiddleName" class="field-error"></span>
    </div>
    <div>
        <label asp-for="LastName" class="block"></label>
        <input asp-for="LastName" class="mt-2 w-full" />
        <span asp-validation-for="LastName" class="field-error"></span>
    </div>
    <div>
        <label asp-for="RoleTitle" class="block"></label>
        <input asp-for="RoleTitle" class="mt-2 w-full" />
        <span asp-validation-for="RoleTitle" class="field-error"></span>
    </div>
    <div>
        <label asp-for="Bio" class="block"></label>
        <textarea asp-for="Bio" rows="4" class="mt-2 w-full"></textarea>
        <span asp-validation-for="Bio" class="field-error"></span>
    </div>
    @if (!string.IsNullOrEmpty(Model.PhotoPath))
    {
        <img src="@Model.PhotoPath" alt="Current image" class="h-32 max-w-full rounded-lg object-contain" />
    }
    <div>
        <label asp-for="ImageFile" class="block"></label>
        <input asp-for="ImageFile" type="file" accept="image/png,image/jpeg,image/webp" class="mt-2 block max-w-full" />
        <span asp-validation-for="ImageFile" class="field-error"></span>
    </div>
    <label class="block"><input asp-for="RemoveImage" /> Remove current image</label>

    <div>
        <label><input asp-for="IsOwner" /> Owner</label>
        <span asp-validation-for="IsOwner" class="field-error"></span>
    </div>
    <div>
        <label asp-for="SortOrder" class="block"></label>
        <input asp-for="SortOrder" class="mt-2 w-full" />
        <span asp-validation-for="SortOrder" class="field-error"></span>
    </div>
    <div>
        <label><input asp-for="IsPublished" /> Published</label>
        <span asp-validation-for="IsPublished" class="field-error"></span>
    </div>
    <button type="submit" class="action-primary">Save</button>
    <a asp-action="Index" class="ml-4 underline">Cancel</a>
</form>
