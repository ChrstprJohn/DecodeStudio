@model ContactViewModel
@inject MyPortfolio.Services.HomeService HomeService
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Contact";
    var editingSection = ViewData["EditingSection"] as string;
    var contact = Model;
}
<h1 class="page-title">Contact</h1>
<div class="mt-8 max-w-3xl">
    <section id="contact-settings" aria-labelledby="contact-settings-heading" class="min-w-0 scroll-mt-6 rounded-xl bg-white p-6 md:p-8">
        <div class="mb-6 flex items-center justify-between gap-4">
            <h2 id="contact-settings-heading" class="text-xl font-semibold">Contact details</h2>
            @if (editingSection != "contact")
            {
                <partial name="_SettingsEditLink" model='@("contact")' />
            }
        </div>
        @if (editingSection == "contact")
        {
            <partial name="_ContactForm" model="contact" />
        }
        else
        {
            <dl class="grid gap-5">
                <div><dt class="text-sm text-neutral-600">Email</dt><dd class="mt-1 break-words">@(string.IsNullOrWhiteSpace(contact.Email) ? "Not set" : contact.Email)</dd></div>
                <div><dt class="text-sm text-neutral-600">Phone</dt><dd class="mt-1">@(string.IsNullOrWhiteSpace(contact.Phone) ? "Not set" : contact.Phone)</dd></div>
                <div>
                    <dt class="text-sm text-neutral-600">Background image</dt>
                    <dd class="mt-2">
                        @if (!string.IsNullOrWhiteSpace(contact.BackgroundImagePath))
                        {
                            <img src="@contact.BackgroundImagePath" alt="Current contact background" class="max-h-52 rounded-lg object-contain" />
                        }
                        else
                        {
                            var gallery = (await HomeService.GetProjectGalleryAsync()).Previews;
                            @if (gallery.Count > 0)
                            {
                                <div class="contact-upload-preview upload-preview pointer-events-none" aria-label="Default website collage" role="img">
                                    <partial name="_ContactCollage" model="gallery" />
                                </div>
                            }
                            else
                            {
                                <span>Not set</span>
                            }
                        }
                    </dd>
                </div>
            </dl>
        }
    </section>
</div>
