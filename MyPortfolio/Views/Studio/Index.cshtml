@model SiteContentViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Website Details";
    var editingSection = ViewData["EditingSection"] as string;
    var studio = Model;
    var studioFields = new (string Label, string? Value)[]
    {
        ("Studio name", studio.StudioName), ("Tagline", studio.Tagline),
        ("Hero title", studio.HeroTitle), ("Hero description", studio.HeroDescription),
        ("About heading", studio.AboutTitle), ("About description", studio.AboutDescription)
    };
}
<h1 class="page-title">Website Details</h1>
<div class="mt-8 max-w-3xl">
    <section aria-labelledby="studio-details-heading" class="min-w-0 rounded-xl bg-white p-6 md:p-8">
        <div class="mb-6 flex items-center justify-between gap-4">
            <h2 id="studio-details-heading" class="text-xl font-semibold">Brand &amp; copy</h2>
            @if (editingSection != "studio")
            {
                <partial name="_SettingsEditLink" model='@("studio")' />
            }
        </div>
        @if (editingSection == "studio")
        {
            <partial name="_StudioForm" model="studio" />
        }
        else
        {
            <dl class="grid gap-5">
                @foreach (var field in studioFields)
                {
                    <div>
                        <dt class="text-sm text-neutral-600">@field.Label</dt>
                        <dd class="mt-1 whitespace-pre-line break-words">@(string.IsNullOrWhiteSpace(field.Value) ? "Not set" : field.Value)</dd>
                    </div>
                }
            </dl>
        }
    </section>
</div>
