@model SiteContentViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Studio content";
}
<h1 class="page-title">Studio content</h1>
<p class="mt-4">Save this form to create or update the studio's single content record.</p>
<form asp-action="Edit" method="post" enctype="multipart/form-data" class="mt-8 max-w-3xl space-y-6 rounded-xl bg-white p-6 md:p-8">
    <div asp-validation-summary="ModelOnly" role="alert" class="text-red-700"></div>
    <div><label asp-for="StudioName" class="block"></label><input asp-for="StudioName" class="mt-2 w-full" /><span asp-validation-for="StudioName" class="field-error"></span></div>
    <div><label asp-for="Tagline" class="block"></label><input asp-for="Tagline" class="mt-2 w-full" /><span asp-validation-for="Tagline" class="field-error"></span></div>
    <div><label asp-for="HeroTitle" class="block"></label><input asp-for="HeroTitle" class="mt-2 w-full" /><span asp-validation-for="HeroTitle" class="field-error"></span></div>
    <div><label asp-for="HeroDescription" class="block"></label><textarea asp-for="HeroDescription" rows="4" class="mt-2 w-full"></textarea><span asp-validation-for="HeroDescription" class="field-error"></span></div>
    @if (!string.IsNullOrEmpty(Model.HeroImagePath))
    {
        <img src="@Model.HeroImagePath" alt="Current image" class="h-32 max-w-full rounded-lg object-contain" />
    }
    <div>
        <label asp-for="ImageFile" class="block"></label>
        <input asp-for="ImageFile" type="file" accept="image/png,image/jpeg,image/webp" class="mt-2 block max-w-full" />
        <span asp-validation-for="ImageFile" class="field-error"></span>
    </div>
    <label class="block"><input asp-for="RemoveImage" /> Remove current image</label>

    <div><label asp-for="HeroLinkText" class="block"></label><input asp-for="HeroLinkText" class="mt-2 w-full" /><span asp-validation-for="HeroLinkText" class="field-error"></span></div>
    <div><label asp-for="HeroLinkUrl" class="block"></label><input asp-for="HeroLinkUrl" class="mt-2 w-full" /><span asp-validation-for="HeroLinkUrl" class="field-error"></span></div>
    <div><label asp-for="AboutTitle" class="block"></label><input asp-for="AboutTitle" class="mt-2 w-full" /><span asp-validation-for="AboutTitle" class="field-error"></span></div>
    <div><label asp-for="AboutDescription" class="block"></label><textarea asp-for="AboutDescription" rows="4" class="mt-2 w-full"></textarea><span asp-validation-for="AboutDescription" class="field-error"></span></div>
    <div><label asp-for="ContactEmail" class="block"></label><input asp-for="ContactEmail" class="mt-2 w-full" /><span asp-validation-for="ContactEmail" class="field-error"></span></div>
    <div><label asp-for="ContactPhone" class="block"></label><input asp-for="ContactPhone" class="mt-2 w-full" /><span asp-validation-for="ContactPhone" class="field-error"></span></div>
    <div><label asp-for="FooterText" class="block"></label><input asp-for="FooterText" class="mt-2 w-full" /><span asp-validation-for="FooterText" class="field-error"></span></div>
    <p>Hero link: http/https URL, /path, or #section.</p>
    <button class="action-primary" type="submit">Save studio content</button>
</form>
<a asp-action="Delete" class="mt-8 inline-block underline">Clear studio content</a>
