@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Clear studio and contact details";
}
<h1 class="page-title">Clear studio and contact details</h1>
<p class="mt-6">Remove the saved hero, About, contact, and footer record? Projects, services, team, and links will stay.</p>
<form asp-action="Delete" method="post" class="mt-6">
    <input type="hidden" name="confirmed" value="true" />
    <div class="flex flex-wrap items-center gap-2">
        <button type="submit" class="admin-secondary">Clear content</button>
        <a asp-action="Index" class="admin-secondary">Cancel</a>
    </div>
</form>
