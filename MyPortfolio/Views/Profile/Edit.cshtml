@model ProfileViewModel
@{
    ViewData["Title"] = "Edit profile";
    var fullName = string.Join(" ", new[] { Model.FirstName, Model.MiddleName, Model.LastName }.Where(name => !string.IsNullOrWhiteSpace(name)));
}
<div class="max-w-6xl @(User.IsInRole("Admin") ? "" : "mx-auto my-10 w-[calc(100%-3rem)] md:my-16")">
    <a asp-action="Index" class="mb-5 inline-flex items-center gap-2 text-sm font-medium hover:underline">
        <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 fill-none stroke-current" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 5-5 5 5 5" /></svg>
        Back to profile
    </a>
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="edit-form rounded-xl border border-neutral-200 bg-white p-6 md:p-8">
        <h1 class="text-xl font-semibold">Personal information</h1>
        <div asp-validation-summary="ModelOnly" role="alert" class="text-red-700"></div>
        <div class="mt-3 flex items-center gap-5">
            <div class="profile-photo-editor relative shrink-0">
                <input asp-for="Photo" type="file" accept="image/png,image/jpeg,image/webp" class="sr-only" data-upload-preview />
                <partial name="_UploadPreview" model='("Photo", Model.ProfileImagePath)' />
                <label asp-for="Photo" title="Change profile photo" class="absolute -top-1 -right-1 grid size-9 cursor-pointer place-items-center rounded-full border border-neutral-300 bg-white shadow-sm hover:bg-neutral-100">
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m14 5 5 5M4 20l5-1L20 8a2 2 0 0 0-4-4L5 15z" /></svg>
                    <span class="sr-only">Change profile photo</span>
                </label>
            </div>
            <div class="min-w-0">
                <p class="break-words text-xl font-semibold">@fullName</p>
                <span asp-validation-for="Photo" class="field-error"></span>
            </div>
        </div>
        <div class="mt-4 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-4">
            <div><label asp-for="FirstName" class="block text-sm text-neutral-600"></label><input asp-for="FirstName" placeholder="e.g. Alex" class="mt-2 w-full" /><span asp-validation-for="FirstName" class="field-error"></span></div>
            <div><label asp-for="MiddleName" class="block text-sm text-neutral-600"></label><input asp-for="MiddleName" placeholder="Optional" class="mt-2 w-full" /><span asp-validation-for="MiddleName" class="field-error"></span></div>
            <div><label asp-for="LastName" class="block text-sm text-neutral-600"></label><input asp-for="LastName" placeholder="e.g. Rivera" class="mt-2 w-full" /><span asp-validation-for="LastName" class="field-error"></span></div>
            <div><label asp-for="Email" class="block text-sm text-neutral-600"></label><input asp-for="Email" placeholder="you@example.com" class="mt-2 w-full" /><span asp-validation-for="Email" class="field-error"></span></div>
        </div>
        <div class="edit-form-actions">
            <button type="submit" class="admin-primary">Save profile</button>
        </div>
    </form>
</div>
