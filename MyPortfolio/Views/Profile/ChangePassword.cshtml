@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}
<div class="account-panel">
    <h1 class="page-title">Change password</h1>
    <form asp-action="ChangePassword" method="post" class="mt-6 space-y-5">
        <div asp-validation-summary="ModelOnly" role="alert" class="text-red-700"></div>
        <div><label asp-for="CurrentPassword" class="block"></label><input asp-for="CurrentPassword" autocomplete="current-password" class="mt-2 w-full" /><span asp-validation-for="CurrentPassword" class="field-error"></span></div>
        <div><label asp-for="NewPassword" class="block"></label><input asp-for="NewPassword" autocomplete="new-password" class="mt-2 w-full" /><span asp-validation-for="NewPassword" class="field-error"></span></div>
        <div><label asp-for="ConfirmPassword" class="block"></label><input asp-for="ConfirmPassword" autocomplete="new-password" class="mt-2 w-full" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
        <button type="submit" class="action-primary">Change password</button>
        <a asp-action="Index" class="ml-4 underline">Cancel</a>
    </form>
</div>
