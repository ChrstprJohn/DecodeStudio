@model SocialLinkViewModel
@using MyPortfolio.Models
@{
    Layout = "_AdminLayout";
    var action = Model.Id == 0 ? "Create" : "Edit";
    ViewData["Title"] = action + " social link";
    var iconSource = Model.RemoveCustomIcon ? null : Model.CurrentIconSource;
    iconSource ??= Url.Content(SocialPlatforms.IconPath(Model.Label));
}
<partial name="_EditBackLink" model='("Back to social links")' />
<h1 class="page-title">@ViewData["Title"]</h1>
<form asp-action="@action" method="post" enctype="multipart/form-data" class="edit-form mt-6 max-w-3xl rounded-xl border border-neutral-200 bg-white p-5 sm:p-7">
    <div asp-validation-summary="ModelOnly" role="alert" class="text-red-700"></div>
    <input asp-for="Id" type="hidden" />
    <div>
        <label asp-for="Label" class="block"></label>
        <input asp-for="Label" placeholder="e.g. GitHub" class="mt-2 w-full" aria-describedby="social-platform-help" />
        <div id="social-platforms" hidden>
            @foreach (var name in SocialPlatforms.Names)
            {
                <span data-platform="@name" data-icon="@Url.Content(SocialPlatforms.IconPath(name))"></span>
            }
        </div>
        <p id="social-platform-help" class="mt-2 text-sm">Type a platform name to use its icon automatically.</p>
        <span asp-validation-for="Label" class="field-error"></span>
    </div>
    <div class="social-icon-upload">
        <label asp-for="CustomIconFile" class="block"></label>
        <input asp-for="CustomIconFile" accept=".svg,image/svg+xml" aria-describedby="custom-icon-help" class="sr-only" data-social-icon-upload data-current-icon="@Model.CurrentIconSource" />
        <partial name="_UploadPreview" model='("CustomIconFile", iconSource)' />
        <p id="custom-icon-help" class="mt-2 text-sm">Optional. Upload a plain SVG up to 64 KB to replace the platform icon.</p>
        <span asp-validation-for="CustomIconFile" class="field-error"></span>
        @if (Model.CurrentIconSource is not null)
        {
            <label class="mt-3 block"><input asp-for="RemoveCustomIcon" /> @Html.DisplayNameFor(model => model.RemoveCustomIcon)</label>
        }
    </div>
    <div>
        <label asp-for="Url" class="block">URL</label>
        <input asp-for="Url" placeholder="https://github.com/yourname" class="mt-2 w-full" />
        <span asp-validation-for="Url" class="field-error"></span>
    </div>
    <div>
        <label asp-for="SortOrder" class="block"></label>
        <input asp-for="SortOrder" class="mt-2 w-full" />
        <span asp-validation-for="SortOrder" class="field-error"></span>
    </div>
    <div class="edit-form-actions">
        <button type="submit" class="admin-primary">Save</button>
        <a asp-action="Index" class="admin-secondary">Cancel</a>
    </div>
</form>
