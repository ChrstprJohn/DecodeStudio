@model List<MyPortfolio.Models.Entities.SocialLink>
@using MyPortfolio.Models
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Social links";
}
<div class="admin-page-header">
    <h1 class="page-title">Social links</h1>
    <a asp-action="Create" class="admin-primary">Add social link</a>
</div>
@if (Model.Count == 0)
{
    <p>No entries yet.</p>
}
else
{
    <div class="admin-table-panel">
    <table class="data-table">
        <thead><tr><th scope="col">Icon</th><th scope="col">Name</th><th scope="col">Order</th><th scope="col" class="admin-actions-heading">Actions</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr class="border-t border-slate-200">
                <td>
                    @if ((SocialIcon.Source(item.CustomIconSvg) ?? Url.Content(SocialPlatforms.IconPath(item.Label))) is { } icon)
                    {
                        <img src="@icon" class="object-contain" width="24" height="24" alt="" />
                    }
                    else
                    {
                        <span aria-label="No icon">—</span>
                    }
                </td>
                <td class="py-3">@( item.Label )</td><td>@item.SortOrder</td>
                <td><div class="admin-row-actions"><a asp-action="Edit" asp-route-id="@item.Id" >Edit</a> <a asp-action="Delete" asp-route-id="@item.Id" class="admin-delete-action" data-confirm-delete="Delete social link" data-delete-message="@($"Delete {item.Label}? This cannot be undone.")">Delete</a></div></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
