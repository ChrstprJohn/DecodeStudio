@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["HeroHeader"] = true;
    ViewData["ContactEmail"] = Model.Content?.ContactEmail;
    ViewData["Tagline"] = Model.Content?.Tagline;
}
<partial name="Sections/_Hero" model="Model" />
<partial name="Sections/_About" model="Model" />
<partial name="Sections/_Services" model="Model" />
<partial name="Sections/_Projects" model="Model" />
<partial name="Sections/_Team" model="Model" />
<partial name="Sections/_Contact" model="Model" />

@section Scripts {
    <script src="~/lib/gsap/gsap.min.js" asp-append-version="true" defer></script>
    <script src="~/lib/gsap/CustomEase.min.js" asp-append-version="true" defer></script>
    <script src="~/js/hero-palette.js" asp-append-version="true" defer></script>
    <script src="~/js/hero-animation.js" asp-append-version="true" defer></script>
    <script src="~/js/section-animation.js" asp-append-version="true" defer></script>
}


