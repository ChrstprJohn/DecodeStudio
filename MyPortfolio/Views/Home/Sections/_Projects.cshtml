@model HomeViewModel
@{
    var groups = Model.Projects.Chunk(6).ToArray();
}
<section id="projects" aria-labelledby="projects-heading" class="studio-showcase">
    <h2 id="projects-heading" class="sr-only">Product Showcase</h2>
    @for (var groupIndex = 0; groupIndex < groups.Length; groupIndex++)
    {
        <div class="showcase-wall">
            @foreach (var project in groups[groupIndex])
            {
                var isSample = project.ImagePath.StartsWith("/images/projects/preview-") &&
                    project.WebsiteUrl.StartsWith("https://example.com/?project=");
                var destination = isSample ? project.ImagePath : project.WebsiteUrl;
                var action = isSample ? "View preview of" : "Visit";
                <a href="@destination" target="_blank" rel="noopener" class="showcase-project" aria-label="@action @project.Title (opens in a new tab)">
                    <img src="@project.ImagePath" alt="@project.Title preview" loading="lazy" asp-append-version="true" />
                    <span>@project.Title.Replace(" (Demo)", "") <span aria-hidden="true">↗</span></span>
                </a>
            }
            @for (var slot = groups[groupIndex].Length; slot < 6; slot++)
            {
                <div class="showcase-empty" aria-hidden="true"></div>
            }
        </div>
        @if (groupIndex < groups.Length - 1)
        {
            <p class="showcase-signature">Created by <span><partial name="_StudioWordmark" /></span></p>
        }
    }
</section>
