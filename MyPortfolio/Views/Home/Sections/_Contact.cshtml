@model HomeViewModel
@{
    var phone = Model.Content?.ContactPhone?.Trim() ?? "";
    var phoneDigits = string.Concat(phone.Where(char.IsAsciiDigit));
    var dialNumber = phone.StartsWith('+') ? "+" + phoneDigits : phoneDigits;
}
<section id="contact" aria-labelledby="contact-heading" class="studio-contact studio-section-width">
    @if (!string.IsNullOrEmpty(Model.Content?.ContactBackgroundImagePath))
    {
        <img class="contact-background" src="@Model.Content.ContactBackgroundImagePath" alt="" loading="lazy" decoding="async" asp-append-version="true" />
    }
    else
    {
        <partial name="_ContactCollage" model="Model.HeroPreviews" />
    }
    <div class="contact-copy">
            <h2 id="contact-heading" class="section-title">Contact</h2>
            <p class="contact-description">Planning a new website or a redesign? Tell us about your project and when you’d like to launch.</p>
            <div class="contact-actions">
            @if (!string.IsNullOrEmpty(Model.Content?.ContactEmail))
            {
                <a href="mailto:@Model.Content.ContactEmail" class="contact-action"><svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg><span class="min-w-0 [overflow-wrap:anywhere]">@Model.Content.ContactEmail</span></a>
            }
            @if (phoneDigits.Length > 0)
            {
                <a href="tel:@dialNumber" class="contact-action"><svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-4l-5-2-2 3a14 14 0 0 1-7-7l3-2-2-5Z" /></svg><span class="min-w-0 [overflow-wrap:anywhere]">@phone</span></a>
            }
            </div>
    </div>
</section>
