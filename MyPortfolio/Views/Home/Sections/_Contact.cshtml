@model HomeViewModel
<section id="contact" aria-labelledby="contact-heading" class="bg-white text-ink">
    <div class="public-width grid gap-12 py-20 md:grid-cols-2 md:py-28">
        <div>
            <h2 id="contact-heading" class="section-title">Contact</h2>
            @if (!string.IsNullOrEmpty(Model.Content?.ContactEmail))
            {
                <a href="mailto:@Model.Content.ContactEmail" class="mt-10 inline-flex max-w-full items-center gap-3 text-2xl tracking-[-0.04em] underline md:text-3xl"><svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg><span class="break-all">@Model.Content.ContactEmail</span></a>
            }
            @if (!string.IsNullOrEmpty(Model.Content?.ContactPhone))
            {
                <p class="mt-4 flex items-center gap-3 text-base"><svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-4l-5-2-2 3a14 14 0 0 1-7-7l3-2-2-5Z" /></svg>@Model.Content.ContactPhone</p>
            }
        </div>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-5 self-end text-base">
            @foreach (var link in Model.SocialLinks)
            {
                <li><a href="@link.Url" class="inline-flex items-center gap-2 underline decoration-black/30 underline-offset-4 hover:decoration-black">@link.Label<svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 16 16 4M4 4h12v12" /></svg></a></li>
            }
        </ul>
    </div>
</section>
