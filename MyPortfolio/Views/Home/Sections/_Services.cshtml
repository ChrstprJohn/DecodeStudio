@model HomeViewModel
<section id="services" aria-labelledby="services-heading" class="studio-services">
    <div class="studio-section-width">
        <h2 id="services-heading" class="studio-section-heading">Start your next chapter.</h2>
        <p class="sr-only">Services</p>
        <div class="service-grid">
            @for (var index = 0; index < Model.Services.Count; index++)
            {
                var service = Model.Services[index];
                var imagePath = DemoImagePaths.Service(service.Title, service.ImagePath);
                <article class="service-card @(index == 0 ? "service-card-featured" : "")">
                    <div class="service-copy">
                        <h3>@service.Title</h3>
                        <p>@service.Description</p>
                    </div>
                    @if (!string.IsNullOrEmpty(imagePath))
                    {
                        <div class="service-visual">
                            <img src="@imagePath" alt="" loading="lazy" />
                        </div>
                    }
                    <a href="#contact" class="service-link @(index == 0 ? "service-link-light" : "")" aria-label="Learn more about @service.Title">Learn more <svg aria-hidden="true" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 16 16 4M4 4h12v12" /></svg></a>
                </article>
            }
        </div>
    </div>
</section>


