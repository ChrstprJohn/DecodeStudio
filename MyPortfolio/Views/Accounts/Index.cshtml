@model List<AccountViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Accounts";
}
<h1 class="page-title">Account management</h1>
<nav aria-label="Account filters" class="my-6 flex gap-6">
    <a asp-action="Index" class="underline">All</a>
    <a asp-action="Index" asp-route-status="active" class="underline">Active</a>
    <a asp-action="Index" asp-route-status="inactive" class="underline">Inactive</a>
</nav>
@if (Model.Count == 0)
{
    <p>No matching accounts.</p>
}
else
{
    <div class="overflow-x-auto rounded-lg bg-white"><table class="data-table">
        <thead><tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
        <tbody>
        @foreach (var account in Model)
        {
            <tr class="border-t border-slate-200">
                <td class="py-3">@account.FirstName @account.LastName</td>
                <td>@account.Email</td><td>@account.Role</td><td>@(account.IsActive ? "Active" : "Inactive")</td>
                <td><a asp-action="Details" asp-route-id="@account.Id" class="underline">View account</a></td>
            </tr>
        }
        </tbody>
    </table></div>
}
