@model RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="account-panel">
    <h1 class="page-title">Sign up</h1>
    <p class="mt-3 text-sm leading-relaxed text-[#555555]">Create your account to explore the studio and manage your profile.</p>
    <form asp-controller="Account" asp-action="Register" method="post" class="mt-6 space-y-5">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <div>
            <label asp-for="FirstName" class="block"></label>
            <input asp-for="FirstName" placeholder="e.g. Alex" autocomplete="given-name" required maxlength="100" class="mt-2 w-full" />
            <span asp-validation-for="FirstName" class="block text-sm"></span>
        </div>
        <div>
            <label asp-for="MiddleName" class="block"></label>
            <input asp-for="MiddleName" placeholder="Optional" autocomplete="additional-name" maxlength="100" class="mt-2 w-full" />
            <span asp-validation-for="MiddleName" class="block text-sm"></span>
        </div>
        <div>
            <label asp-for="LastName" class="block"></label>
            <input asp-for="LastName" placeholder="e.g. Rivera" autocomplete="family-name" required maxlength="100" class="mt-2 w-full" />
            <span asp-validation-for="LastName" class="block text-sm"></span>
        </div>
        <div>
            <label asp-for="Email" class="block"></label>
            <input asp-for="Email" placeholder="you@example.com" type="email" autocomplete="username" required maxlength="256" class="mt-2 w-full" />
            <span asp-validation-for="Email" class="block text-sm"></span>
        </div>
        <div>
            <label asp-for="Password" class="block"></label>
            <input asp-for="Password" autocomplete="new-password" required minlength="8" maxlength="128" class="mt-2 w-full" />
            <span asp-validation-for="Password" class="block text-sm"></span>
        </div>
        <div>
            <label asp-for="ConfirmPassword" class="block"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" required maxlength="128" class="mt-2 w-full" />
            <span asp-validation-for="ConfirmPassword" class="block text-sm"></span>
        </div>
        <button type="submit" class="action-primary">Create account</button>
    </form>
    <p class="mt-6">Already registered? <a asp-controller="Account" asp-action="Login" class="underline">Log in</a></p>
</div>
