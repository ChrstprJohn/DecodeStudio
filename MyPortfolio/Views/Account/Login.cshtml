@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="account-panel">
    <h1 class="page-title">Log in</h1>
    <p class="mt-3 text-sm leading-relaxed text-[#555555]">Welcome back. Log in to your Decode Studio account.</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <p class="mt-6">You are signed in as @User.Identity.Name.</p>
        <a class="mt-4 block underline" asp-controller="Home" asp-action="Index">Go to home</a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="mt-6">
            <button type="submit" class="action-secondary">Log out</button>
        </form>
    }
    else
    {
        <form asp-controller="Account" asp-action="Login" method="post" class="mt-6 space-y-5">
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div>
                <label asp-for="Email" class="block"></label>
                <input asp-for="Email" placeholder="you@example.com" type="email" autocomplete="username" required class="mt-2 w-full" />
                <span asp-validation-for="Email" class="block text-sm"></span>
            </div>
            <div>
                <label asp-for="Password" class="block"></label>
                <input asp-for="Password" autocomplete="current-password" required maxlength="128" class="mt-2 w-full" />
                <span asp-validation-for="Password" class="block text-sm"></span>
            </div>
            <button type="submit" class="action-primary">Log in</button>
        </form>
        <p class="mt-6">No account? <a asp-controller="Account" asp-action="Register" class="underline">Sign up</a></p>
    }
</div>
