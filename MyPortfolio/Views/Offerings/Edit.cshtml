@model ServiceOfferingViewModel
@{
    Layout = "_AdminLayout";
    var action = Model.Id == 0 ? "Create" : "Edit";
    ViewData["Title"] = action + " service";
    var currentImage = DemoImagePaths.Service(Model.Title, Model.ImagePath);
}
<h1 class="page-title">@ViewData["Title"]</h1>
<form asp-action="@action" method="post" enctype="multipart/form-data" class="mt-8 max-w-3xl space-y-6 rounded-xl bg-white p-6 md:p-8">
    <div asp-validation-summary="ModelOnly" role="alert" class="text-red-700"></div>
    <input asp-for="Id" type="hidden" />
    <div>
        <label asp-for="Title" class="block"></label>
        <input asp-for="Title" class="mt-2 w-full" />
        <span asp-validation-for="Title" class="field-error"></span>
    </div>
    <div>
        <label asp-for="Description" class="block"></label>
        <textarea asp-for="Description" rows="4" class="mt-2 w-full"></textarea>
        <span asp-validation-for="Description" class="field-error"></span>
    </div>
    <div>
        <label asp-for="ImageFile" class="block"></label>
        <input asp-for="ImageFile" type="file" accept="image/png,image/jpeg,image/webp" class="mt-2 w-full" />
        <span asp-validation-for="ImageFile" class="field-error"></span>
        @if (!string.IsNullOrEmpty(currentImage))
        {
            <img src="@currentImage" alt="Current service image" class="mt-3 max-h-48 rounded-lg object-contain" />
        }
    </div>
    <div>
        <label asp-for="SortOrder" class="block"></label>
        <input asp-for="SortOrder" class="mt-2 w-full" />
        <span asp-validation-for="SortOrder" class="field-error"></span>
    </div>
    <div>
        <label><input asp-for="IsPublished" /> Published</label>
        <span asp-validation-for="IsPublished" class="field-error"></span>
    </div>
    <button type="submit" class="action-primary">Save</button>
    <a asp-action="Index" class="ml-4 underline">Cancel</a>
</form>

