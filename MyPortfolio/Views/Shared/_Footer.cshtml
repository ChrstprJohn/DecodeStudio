@inject MyPortfolio.Services.SocialLinkService SocialLinkService
@{
    var configuredLinks = ViewData.Model is HomeViewModel home ? home.SocialLinks : await SocialLinkService.GetAllAsync();
    var socialLinks = configuredLinks
        .Where(link => Uri.TryCreate(link.Url, UriKind.Absolute, out var url) &&
            (url.Scheme == Uri.UriSchemeHttps || url.Scheme == Uri.UriSchemeHttp))
        .ToList();
}
<footer id="footer" class="studio-footer">
    <div class="footer-columns">
        <div>
            <a asp-controller="Home" asp-action="Index" class="footer-brand"><partial name="_StudioWordmark" /></a>
            <p class="footer-tagline">@(ViewData["Tagline"] ?? "Design. Develop. Deploy.")</p>
        </div>
        <div>
            <h2>Explore</h2>
            <ul>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="about">About the studio</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="services">Services</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="projects">Selected work</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="team">Our people</a></li>
            </ul>
        </div>
        @if (socialLinks.Count > 0)
        {
            <div class="footer-social">
                <h2>Social links</h2>
                <h2>Follow us</h2>
                <ul>
                    @foreach (var link in socialLinks)
                    {
                        <li><a href="@link.Url">@link.Label</a></li>
                    }
                </ul>
            </div>
        }
    </div>
    <div class="footer-display" aria-hidden="true">
        <span class="footer-display-word"><span>D</span><span>E</span><span>C</span><span>O</span><span>D</span><span>E</span></span>
    </div>
    <div class="footer-bottom">
        <p>&copy; @DateTime.Now.Year @(ViewData["StudioName"] ?? "Decode Studio")</p>
    </div>
</footer>
