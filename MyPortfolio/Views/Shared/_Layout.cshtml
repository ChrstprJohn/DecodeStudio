@{
    var heroHeader = ViewData["HeroHeader"] is true;
    var adminShell = ViewData["AdminShell"] is true;
    var profilePage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Profile", StringComparison.OrdinalIgnoreCase);
    var studioName = ViewData["StudioName"] as string ?? "Decode Studio";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    @if (heroHeader)
    {
        <script>
            document.documentElement.classList.add('hero-pending');
            // Show content if the animation library fails to load.
            setTimeout(() => document.documentElement.classList.remove('hero-pending'), 4000);
        </script>
    }
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @studioName</title>
    <link rel="icon" href="~/favicon.ico" />
    @if (heroHeader)
    {
        <meta property="og:type" content="website" />
        <meta property="og:title" content="@studioName" />
        <meta property="og:url" content="@Url.Action("Index", "Home", values: null, protocol: Context.Request.Scheme)" />
        <meta property="og:image" content="@(Context.Request.Scheme + "://" + Context.Request.Host + Url.Content("~/favicon.png"))" />
        <meta property="og:image:alt" content="decide." />
    }
    <link rel="preload" href="~/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:p-4">Skip to content</a>
    @if (!adminShell)
    {
    <header class="z-50 @(heroHeader ? "home-header" : "sticky top-0 bg-canvas")">
        <div class="public-width flex min-h-24 items-center justify-between gap-8">
            <a asp-controller="Home" asp-action="Index" aria-label="@studioName home" class="shrink-0 text-2xl font-semibold tracking-[-0.07em]"><partial name="_StudioWordmark" /></a>
            <nav aria-label="Main navigation" class="hidden items-center gap-6 text-sm font-medium lg:flex">
                <a asp-controller="Home" asp-action="Index" asp-fragment="about" class="hover:underline">About</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="services" class="hover:underline">Services</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="projects" class="hover:underline">Work</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="team" class="hover:underline">Team</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="contact" class="hover:underline">Contact</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <partial name="_ProfileMenu" />
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="action-primary" aria-label="Login / Sign up">Login <svg class="auth-slash" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21 21 3" fill="none" stroke="currentColor" stroke-width="1.2" /></svg> Sign up</a>
                }
            </nav>
            <details class="mobile-menu group lg:hidden">
                <summary class="mobile-menu-toggle" aria-label="Menu"><span aria-hidden="true"></span><span aria-hidden="true"></span></summary>
                <nav aria-label="Mobile navigation" class="absolute inset-x-0 top-full flex flex-col gap-5 border-t border-[#dddddd] bg-canvas px-6 py-7 text-base">
                    <a asp-controller="Home" asp-action="Index" asp-fragment="hero">Home</a>
                    <a asp-controller="Home" asp-action="Index" asp-fragment="about">About</a>
                    <a asp-controller="Home" asp-action="Index" asp-fragment="services">Services</a>
                    <a asp-controller="Home" asp-action="Index" asp-fragment="projects">Work</a>
                    <a asp-controller="Home" asp-action="Index" asp-fragment="team">Team</a>
                    <a asp-controller="Home" asp-action="Index" asp-fragment="contact">Contact</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <partial name="_ProfileMenu" />
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login">Log in</a>
                        <a asp-controller="Account" asp-action="Register">Sign up</a>
                    }
                </nav>
            </details>
        </div>
    </header>
    }
    <main id="main-content" tabindex="-1">
        @if (TempData["ErrorMessage"] is string error)
        {
            <p role="alert" class="notice text-red-700">@error</p>
        }
        @RenderBody()
    </main>
    @if (TempData["SuccessMessage"] is string success)
    {
        <div role="status" class="fixed right-4 bottom-4 z-50 w-[calc(100%-2rem)] max-w-sm rounded-lg border border-emerald-200 bg-white px-4 py-3 shadow-lg sm:right-6 sm:bottom-6" data-success-alert>
            <p class="text-sm font-semibold text-emerald-800">Success</p>
            <p class="mt-1 break-words text-sm">@success</p>
        </div>
    }
    @if (!adminShell && !profilePage)
    {
        <partial name="_Footer" />
    }
    <script src="~/lib/gsap/gsap.min.js" asp-append-version="true" defer></script>
    <script src="~/lib/gsap/CustomEase.min.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
