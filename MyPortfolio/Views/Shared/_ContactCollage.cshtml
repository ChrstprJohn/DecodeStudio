@model IReadOnlyList<System.ValueTuple<string, string>>
@if (Model.Count > 0)
{
    <span class="contact-collage" aria-hidden="true">
        @for (var column = 0; column < 7; column++)
        {
            <span class="contact-collage-column">
                @for (var row = 0; row < 7; row++)
                {
                    var tile = (row * 7 + column) % Model.Count;
                    <img src="@Model[tile].Item1" alt="" loading="lazy" decoding="async" asp-append-version="true" />
                }
            </span>
        }
    </span>
}
