@model string
<a asp-action="Index" asp-route-edit="@Model"
   aria-label="Edit @(Model == "contact" ? "contact details" : "brand and copy")"
   class="inline-flex min-h-10 shrink-0 items-center gap-2 rounded-lg border border-neutral-300 px-4 text-sm font-medium hover:bg-neutral-100">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m14 5 5 5M4 20l5-1L20 8a2 2 0 0 0-4-4L5 15z" /></svg>
    Edit
</a>
