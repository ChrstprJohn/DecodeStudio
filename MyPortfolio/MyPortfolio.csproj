<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>decode-studio-portfolio-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Pin the patched version of the SQL client's transitive dependency. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <Target Name="BuildTailwind" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="node_modules/gsap/dist/gsap.min.js" DestinationFolder="wwwroot/lib/gsap" SkipUnchangedFiles="true" />
    <Copy SourceFiles="node_modules/gsap/dist/CustomEase.min.js" DestinationFolder="wwwroot/lib/gsap" SkipUnchangedFiles="true" />
    <Exec Command="npm run css:build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <ItemGroup>
    <!-- Include generated CSS even when it does not exist at project evaluation. -->
    <Content Remove="wwwroot/css/site.css" />
    <Content Include="wwwroot/css/site.css" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>


